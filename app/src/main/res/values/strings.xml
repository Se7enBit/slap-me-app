    <!-- Usage access disclosure (shown before opening the usage access settings) -->
    <string name="usage_disclosure_title">Usage access</string>
    <string name="usage_disclosure_intro">Slap Me needs Usage Access, a special Android permission, to know how long you\'ve been using your phone without a break.</string>
    <string name="usage_disclosure_reads_title">What it reads</string>
    <string name="usage_disclosure_reads">Which app is in the foreground, and when it came to the front. Nothing inside your apps.</string>
    <string name="usage_disclosure_why_title">Why</string>
    <string name="usage_disclosure_why">To count continuous use during your focus time, to skip calls, navigation and the camera, and to apply your list of distracting or allowed apps.</string>
    <string name="usage_disclosure_privacy_title">Where it goes</string>
    <string name="usage_disclosure_privacy">Nowhere. It stays on this phone. Slap Me has no internet access and never collects or shares your data.</string>
    <string name="usage_disclosure_accept">Agree and continue</string>
    <string name="usage_disclosure_decline">Not now</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Meet Slap Me</string>
    <string name="onboarding_welcome_1">During your focus time, Slap Me counts how long you\'ve been on your phone without a break.</string>
    <string name="onboarding_welcome_2">Go over your limit and you get a warning, then a cartoon slap that sends you back to the home screen.</string>
    <string name="onboarding_welcome_3">Every slap shortens the next limit; a real break resets it. Fun, a bit annoying, never harmful.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_usage_title">Allow usage access</string>
    <string name="onboarding_usage_body">In the list that opens, pick Slap Me and turn on \"Permit usage access\". Then come back here.</string>
    <string name="onboarding_overlay_title">Allow display over other apps</string>
    <string name="onboarding_overlay_body">The slap appears over whatever app you\'re in, and this is also what lets Slap Me send you to the home screen. Turn on \"Allow display over other apps\" for Slap Me.</string>
    <string name="onboarding_notifications_title">Allow notifications</string>
    <string name="onboarding_notifications_body">You\'ll get a warning before each slap with a button to snooze, and a short note after it.</string>
    <string name="onboarding_battery_title">Keep Slap Me running</string>
    <string name="onboarding_battery_body">Some phones stop apps in the background to save battery. Set Slap Me\'s battery use to \"Unrestricted\" (or \"No restrictions\") so it keeps watching.</string>
    <string name="onboarding_battery_unrestricted">Slap Me is already unrestricted</string>
    <string name="onboarding_battery_xiaomi">On Xiaomi, Redmi and POCO phones, also turn on Autostart for Slap Me so it comes back after a restart.</string>
    <string name="onboarding_open_battery_settings">Open battery settings</string>
    <string name="onboarding_open_autostart">Open Autostart</string>
    <string name="onboarding_open_settings">Open settings</string>
