    <string name="onboarding_skip">Skip for now</string>
    <string name="onboarding_finish">Finish</string>
    <string name="onboarding_granted">Done</string>

    <!-- Home: fix-it cards -->
    <string name="fix_usage_title">Usage access is off</string>
    <string name="fix_usage_text">Slap Me can\'t tell which app is open: calls, maps and the camera would count, and your app lists don\'t work.</string>
    <string name="fix_overlay_title">Display over other apps is off</string>
    <string name="fix_overlay_text">Without it the slap can\'t appear and can\'t send you to the home screen.</string>
    <string name="fix_notifications_title">Notifications are off</string>
    <string name="fix_notifications_text">You won\'t get the warning or the Snooze button before a slap.</string>
    <string name="fix_battery_title">Keep Slap Me running</string>
    <string name="fix_battery_text">Your phone may stop Slap Me in the background to save battery. Set its battery use to \"Unrestricted\".</string>
    <string name="fix_battery_text_killed">Your phone stopped Slap Me in the background recently. Set its battery use to \"Unrestricted\".</string>
    <string name="fix_battery_xiaomi">On Xiaomi, Redmi and POCO phones, also turn on Autostart.</string>
